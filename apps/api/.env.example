# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# Local MySQL 8. The database is created by `npm run db:migrate` if it does not exist.
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/lifeloop
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
# Web origin (used for cookie/security settings)
WEB_ORIGIN=http://localhost:3000
# AI provider: "mock" (rule-based, free, offline) or "anthropic" (needs ANTHROPIC_API_KEY)
AI_PROVIDER=mock
AI_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# OCR languages for Tesseract (language data is downloaded once on first use)
OCR_LANGS=eng
# Local folder for uploaded files
STORAGE_DIR=./storage

# Reminders & email
SCHEDULER_ENABLED=true
# console = emails are printed in the API terminal and saved to STORAGE_DIR/outbox (default)
# smtp    = real email. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#           SMTP_PASS=<16-character App Password from https://myaccount.google.com/apppasswords>
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=LifeLoop <no-reply@lifeloop.local>
APP_URL=http://localhost:3000

# Google sign-in (optional; the button is hidden until both are set)
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Voice notes: local Whisper speech-to-text (free, offline; models download once to STORAGE_DIR/models)
# English notes: onnx-community/whisper-base (default, ~150 MB, ~2 s per note) or onnx-community/whisper-small
WHISPER_MODEL=onnx-community/whisper-base
# Hindi/Hinglish notes: transcribed as Hindi, then written in Roman letters. Small models garble Hinglish;
# large-v3-turbo gets it right but is ~1.1 GB on disk, needs ~2.7 GB RAM and takes ~10-20 s per note on a laptop.
WHISPER_HINDI_MODEL=onnx-community/whisper-large-v3-turbo

# Phone/browser push (generate once: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
