{
  "name": "@lifeloop/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,node -c gray,blue \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --watch-path=dist --watch dist/main.js\"",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "dev:nest": "nest start --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@huggingface/transformers": "^4.3.2",
    "@nestjs/apollo": "^14.2.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/graphql": "^14.2.0",
    "@nestjs/platform-express": "^12.4.0",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "graphql": "^16.15.0",
    "jose": "^6.2.16",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "source-map-support": "^0.5.21",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "type": "module"
}
